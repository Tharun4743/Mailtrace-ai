# ==============================================================================
# MAILTRACE AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ---------------- APPLICATION ----------------
PROJECT_NAME="MAILTRACE AI"
VERSION="2.0.0"
ENVIRONMENT="development"

# ---------------- SECURITY / JWT ----------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_64_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- DATABASE & REDIS ----------------
# SQLite for local development:
DATABASE_URL="sqlite:///./mailtrace.db"
# PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/mailtrace"
# Optional Redis for distributed cache:
REDIS_URL="redis://localhost:6379/0"

# ---------------- FRONTEND / CORS ----------------
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"
VITE_API_URL="http://localhost:8000/api/v1"

# ---------------- GOOGLE WORKSPACE / GMAIL OAUTH 2.0 ----------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web Client
# Scopes needed: gmail.readonly, userinfo.email, userinfo.profile, openid
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"

# ---------------- MICROSOFT 365 / AZURE AD OAUTH 2.0 ----------------
# Obtain from Microsoft Entra Admin Center -> App Registrations
# Graph API Delegated Scopes: Mail.Read, User.Read, offline_access, openid, profile, email
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:5173/auth/microsoft/callback"

# ---------------- THREAT INTELLIGENCE FEEDS (OPTIONAL) ----------------
# VirusTotal: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=""
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=""
# AlienVault OTX: https://otx.alienvault.com/api
ALIENVAULT_OTX_KEY=""

# ---------------- GEOLOCATION MMDB PATHS (OPTIONAL) ----------------
# Free MaxMind GeoLite2 databases: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_DATABASE_PATH="./data/GeoLite2-City.mmdb"
GEOIP_ASN_DATABASE_PATH="./data/GeoLite2-ASN.mmdb"

# ---------------- REAL-TIME NOTIFICATIONS (OPTIONAL) ----------------
# Mobile Push Webhook URL (FCM Gateway, Webhook.site, Slack, Discord):
MOBILE_PUSH_WEBHOOK_URL=""

# SMTP Alert Dispatch (Gmail App Password or SendGrid / AWS SES):
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# ---------------- BLOCKCHAIN EVIDENCE ANCHORING (OPTIONAL) ----------------
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=""
BLOCKCHAIN_NETWORK=""
BLOCKCHAIN_PRIVATE_KEY=""
